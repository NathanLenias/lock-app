    <!-- Onboarding: How it works (Page 1) -->
    <string name="onboarding_how_title">How does it work?</string>
    <string name="onboarding_how_subtitle">In 3 simple steps</string>
    <string name="onboarding_how_step1_title">Scan your tag</string>
    <string name="onboarding_how_step1_desc">Place your phone on the NFC tag to activate blocking.</string>
    <string name="onboarding_how_step2_title">Apps are blocked</string>
