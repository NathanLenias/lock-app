    <string name="onboarding_how_step3_title">Scan again to unblock</string>
    <string name="onboarding_how_step3_desc">A new scan deactivates blocking. That\'s it.</string>

    <!-- Onboarding: Why physical (Page 2) -->
    <string name="onboarding_why_title">Get up to unblock.</string>
    <string name="onboarding_why_accent">That\'s what changes everything.</string>
    <string name="onboarding_why_arg1_title">A physical gesture, not a tap</string>
    <string name="onboarding_why_arg1_desc">You have to get up and scan the tag. Friction creates intention.</string>
    <string name="onboarding_why_arg2_title">Impossible to bypass</string>
    <string name="onboarding_why_arg2_desc">No hidden button, no cheating. The tag is the only key.</string>
    <string name="onboarding_why_arg3_title">Not another screen time app</string>
    <string name="onboarding_why_arg3_desc">Lock doesn\'t track your time. It makes scrolling impossible.</string>

    <!-- Onboarding: Permissions (Page 3) -->
    <string name="onboarding_perm_title">Permissions</string>
    <string name="onboarding_perm_subtitle">Lock needs these 3 permissions to work properly. Tap each card to enable them.</string>
    <string name="onboarding_perm_accessibility_title">Accessibility service</string>
    <string name="onboarding_perm_accessibility_desc">Detects when blocked apps are opened</string>
    <string name="onboarding_perm_accessibility_detail">This service allows Lock to detect when you open a blocked app. Without this permission, blocking cannot work.\n\nThis is the core of how Lock works.</string>
    <string name="onboarding_perm_overlay_title">Display over other apps</string>
    <string name="onboarding_perm_overlay_desc">Shows a blocking screen</string>
    <string name="onboarding_perm_overlay_detail">This service allows Lock to display the blocking screen over targeted apps. Without this permission, the blocking screen cannot appear.</string>
    <string name="onboarding_perm_battery_title">Battery optimization</string>
    <string name="onboarding_perm_battery_desc">Prevents Android from stopping Lock</string>
    <string name="onboarding_perm_battery_detail">Android may stop Lock in the background to save battery.\n\nThis permission ensures blocking stays active even when the screen is off.</string>
    <string name="onboarding_perm_info">Each permission is configured manually in Android settings. No data is collected.</string>
