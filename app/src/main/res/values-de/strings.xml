    <!-- Onboarding: Why physical (Page 2) -->
    <string name="onboarding_why_title">Aufstehen zum Entsperren.</string>
    <string name="onboarding_why_accent">Genau das ändert alles.</string>
    <string name="onboarding_why_arg1_title">Eine körperliche Geste, kein Tippen</string>
    <string name="onboarding_why_arg1_desc">Sie müssen aufstehen und das Tag scannen. Die Hürde schafft Absicht.</string>
    <string name="onboarding_why_arg2_title">Nicht zu umgehen</string>
    <string name="onboarding_why_arg2_desc">Kein versteckter Knopf, kein Schummeln. Das Tag ist der einzige Schlüssel.</string>
    <string name="onboarding_why_arg3_title">Keine weitere Bildschirmzeit-App</string>
    <string name="onboarding_why_arg3_desc">Lock verfolgt nicht Ihre Zeit. Es macht Scrollen unmöglich.</string>

    <!-- Onboarding: Permissions (Page 3) -->
    <string name="onboarding_perm_title">Berechtigungen</string>
    <string name="onboarding_perm_subtitle">Lock benötigt diese 3 Berechtigungen, um richtig zu funktionieren. Tippen Sie auf jede Karte, um sie zu aktivieren.</string>
    <string name="onboarding_perm_accessibility_title">Bedienungshilfen-Dienst</string>
    <string name="onboarding_perm_accessibility_desc">Erkennt, wenn blockierte Apps geöffnet werden</string>
    <string name="onboarding_perm_accessibility_detail">Dieser Dienst ermöglicht es Lock zu erkennen, wenn Sie eine blockierte App öffnen. Ohne diese Berechtigung kann die Blockierung nicht funktionieren.\n\nDas ist der Kern der Funktionsweise von Lock.</string>
    <string name="onboarding_perm_overlay_title">Über anderen Apps anzeigen</string>
    <string name="onboarding_perm_overlay_desc">Zeigt einen Blockierbildschirm an</string>
    <string name="onboarding_perm_overlay_detail">Dieser Dienst ermöglicht es Lock, den Blockierbildschirm über den ausgewählten Apps anzuzeigen. Ohne diese Berechtigung kann der Blockierbildschirm nicht erscheinen.</string>
    <string name="onboarding_perm_battery_title">Akku-Optimierung</string>
    <string name="onboarding_perm_battery_desc">Verhindert, dass Android Lock stoppt</string>
    <string name="onboarding_perm_battery_detail">Android kann Lock im Hintergrund stoppen, um Akku zu sparen.\n\nDiese Berechtigung sorgt dafür, dass die Blockierung auch bei ausgeschaltetem Bildschirm aktiv bleibt.</string>
    <string name="onboarding_perm_info">Jede Berechtigung wird manuell in den Android-Einstellungen konfiguriert. Es werden keine Daten erfasst.</string>
    <string name="onboarding_perm_cta">Berechtigungen einrichten</string>
