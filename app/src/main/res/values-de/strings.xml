    <string name="onboarding_how_subtitle">In 3 einfachen Schritten</string>
    <string name="onboarding_how_step1_title">Tag scannen</string>
    <string name="onboarding_how_step1_desc">Legen Sie Ihr Telefon auf das NFC-Tag, um die Blockierung zu aktivieren.</string>
